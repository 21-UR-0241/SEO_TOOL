    "dev:client": "NODE_OPTIONS='--max-old-space-size=4096' vite",
    "build:client": "NODE_OPTIONS='--max-old-space-size=4096' vite build",
    "build:server": "NODE_OPTIONS='--max-old-space-size=4096' mkdir -p dist && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js --external:./vite.ts",
    "build": "npm run build:server && echo 'Build complete! Checking output:' && ls -la dist/",
    "start": "node --max-old-space-size=4096 dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push"
